<?xml version="1.0" encoding="UTF-8"?>
<!--
  SECURITY — Tomcat context configuration.
  The RFC 6265 cookie processor stamps SameSite=Strict on all cookies
  (including JSESSIONID), which blocks the session cookie from being sent
  on cross-site requests — a strong second layer of CSRF defense on top
  of the per-request _csrf token.
-->
<Context>
    <CookieProcessor
        className="org.apache.tomcat.util.http.Rfc6265CookieProcessor"
        sameSiteCookies="strict" />
</Context>
